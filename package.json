{
  "name": "dsh-task-dock",
  "version": "0.1.0",
  "type": "module",
  "description": "A draggable dock in the window corner that stacks pending confirmations above running sessions above unread results, each row opening its session.",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "dock",
    "unread",
    "approval",
    "sidebar",
    "session"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/peter0429-ux/dsh-task-dock.git"
  },
  "homepage": "https://github.com/peter0429-ux/dsh-task-dock#readme",
  "bugs": {
    "url": "https://github.com/peter0429-ux/dsh-task-dock/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-locale"
      ]
    },
    "manifestVersion": 1
  },
  "peerDependencies": {
    "react": "*"
  }
}
